	     (scheme = "kakao" + 네이티브 앱 키, Android manifest와 동일한 값) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kakao7229f894a0283b794fa0f5080c1e0b01</string>
			</array>
		</dict>
	</array>
	<!-- 카카오톡 설치 여부를 확인해 앱 전환 로그인을 쓰기 위해 필요 -->
