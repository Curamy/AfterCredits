# TMDB API 키 (v3 API Key 또는 v4 Read Access Token 모두 지원)
# 발급: https://www.themoviedb.org/settings/api
TMDB_TOKEN=your_tmdb_key_here

# 카카오 로그인 앱 키 (https://developers.kakao.com > 내 애플리케이션 > 앱 키)
KAKAO_JS_KEY=your_kakao_javascript_key_here
# 웹 로그인은 REST API 키로 인가 코드를 발급받는다 (서버의 토큰 교환 키와 일치해야 함)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key_here
